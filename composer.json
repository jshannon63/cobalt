{
    "name": "jshannon63/cobalt",
    "type": "library",
    "description": "A fast, autowired PSR-11 dependency injection container for PHP with cached resolution closures.",
    "keywords": [
        "container",
        "dependency-injection",
        "ioc",
        "psr-11",
        "service-container",
        "autowire",
        "di"
    ],
    "homepage": "https://github.com/jshannon63/cobalt",
    "license": "MIT",
    "authors": [
        {
            "name": "Jim Shannon",
            "email": "jim@hltky.com",
            "homepage": "https://jimshannon.me/"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "Jshannon63\\Cobalt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jshannon63\\Cobalt\\Tests\\": "tests/"
        }
    },
    "provide": {
        "psr/container-implementation": "2.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --coverage-clover coverage.xml --coverage-text",
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
